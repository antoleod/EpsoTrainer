{
  "name": "epso-trainer",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:all": "npm run typecheck && npm run validate:content && npm test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@react-native-firebase/analytics": "26.3.3",
    "@react-native-firebase/app": "26.3.3",
    "@react-native-firebase/app-check": "26.3.3",
    "@react-native-firebase/auth": "26.3.3",
    "@react-native-firebase/crashlytics": "26.3.3",
    "@react-native-firebase/firestore": "26.3.3",
    "drizzle-orm": "^0.44.5",
    "expo": "~57.0.0",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~57.0.18",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "4.1.10"
  }
}
